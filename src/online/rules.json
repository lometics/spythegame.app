{
  "rules": {
    "rooms": {
      ".read": "auth != null && query.orderByChild == 'lastActive' && query.limitToFirst <= 25",
      ".indexOn": [
        "lastActive"
      ],
      "$code": {
        ".write": "auth != null && (!data.exists() || (!newData.exists() && (!data.exists() || (data.child('lastActive').exists() && data.child('lastActive').val() < now - 2592000000) || (!data.child('lastActive').exists() && (!data.child('meta').child('createdAt').exists() || data.child('meta').child('createdAt').val() < now - 2592000000)))))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('rooms').child($code).child('players').child(auth.uid).exists())"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists())"
          }
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "round": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "votes": {
            "$uid": {
              ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists())"
            }
          }
        },
        "lastActive": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.val() === now"
        }
      }
    },
    "privateWords": {
      "$code": {
        ".write": "(auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (auth != null && !newData.exists() && (!root.child('rooms').child($code).exists() || (root.child('rooms').child($code).child('lastActive').exists() && root.child('rooms').child($code).child('lastActive').val() < now - 2592000000) || (!root.child('rooms').child($code).child('lastActive').exists() && (!root.child('rooms').child($code).child('meta').child('createdAt').exists() || root.child('rooms').child($code).child('meta').child('createdAt').val() < now - 2592000000))))",
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid && !newData.exists()"
        }
      }
    },
    "pairReveals": {
      "$code": {
        ".write": "(auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (auth != null && !newData.exists() && (!root.child('rooms').child($code).exists() || (root.child('rooms').child($code).child('lastActive').exists() && root.child('rooms').child($code).child('lastActive').val() < now - 2592000000) || (!root.child('rooms').child($code).child('lastActive').exists() && (!root.child('rooms').child($code).child('meta').child('createdAt').exists() || root.child('rooms').child($code).child('meta').child('createdAt').val() < now - 2592000000))))",
        ".read": "auth != null && root.child('rooms').child($code).child('meta').child('phase').val() === 'result'"
      }
    },
    "errors": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['msg', 'at'])",
        "msg": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "stack": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
